# Local secrets for `npm run preview` / `next dev` (copy to .dev.vars — never commit it).
DATA_ENCRYPTION_KEY=
IP_HASH_SECRET=
CRON_SECRET=
# Optional Cloudflare Turnstile (also set NEXT_PUBLIC_TURNSTILE_SITE_KEY in .env.local at build time)
# TURNSTILE_SECRET_KEY=

# DEV ONLY: run the scanner locally (no Docker needed) with `npm run scanner`, then uncomment:
# LOCAL_SCANNER_URL=http://127.0.0.1:8080

# Đăng nhập Google (tuỳ chọn; xem README). Redirect URI local: http://localhost:8787/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Kết nối GitHub cho Quét mã nguồn (tuỳ chọn). Tạo OAuth App tại GitHub → Settings → Developer settings → OAuth Apps.
# Callback URL local: http://localhost:3111/api/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
