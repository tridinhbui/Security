# Build-time/public values (read by Next at build). Secrets go in .dev.vars locally and `wrangler secret put` in production.
NEXT_PUBLIC_SITE_URL=http://localhost:8787
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional tuning (set as [vars] in wrangler.jsonc)
# SCAN_DAILY_QUOTA=20
# SCAN_HOURLY_LIMIT=8
# SCAN_MAX_CONCURRENT_PER_USER=2
# SCAN_HOST_HOURLY_LIMIT=4
# AUTH_LOGIN_FAILS_PER_EMAIL=5
